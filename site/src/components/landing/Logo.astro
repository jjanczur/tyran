---
/**
 * The mark: a jackal head with a lash.
 *
 * Inline SVG rather than an `<img>`, so it inherits `currentColor` and costs
 * no request. Same silhouette as the favicon — one shape, two sizes — because
 * a logo that is not the favicon is two logos.
 *
 * The lash appears here and NOT in the favicon: measured at tab size, a curve
 * under the jaw stops reading as a whip and starts reading as a smile.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="Tyran"
  fill="none"
>
  <path
    d="M17 8 L24 27 L28 25 L36 6 L42 27 L47 31 L58 38 L46 43 L36 49 L25 45 L19 34 Z"
    fill="currentColor"
  />
  <circle cx="33" cy="33" r="2.6" fill="var(--l-bg, #12100e)" />
  <path
    d="M13 57 C 21 51, 27 60, 36 54 S 48 47, 55 51"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
  />
</svg>
