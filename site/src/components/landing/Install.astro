---
/**
 * Install, copied straight from the README's Quick Start.
 *
 * Four lines and no npm line: `package.json` publishes a CLI whose own
 * description says installing it does NOT install the plugin, and it is not on
 * the registry yet. Offering it here as an install path would be the first
 * false sentence on the page.
 *
 * The copy buttons are progressive enhancement. The command is real text inside
 * a `<button>`, so with scripting off it is selectable and readable; the script
 * only adds the clipboard write and the "copied" state.
 */
import Icon from './Icon.astro';
import { DOCS, REPO, RELEASE } from './urls';

const STEPS = [
  {
    cmd: '/plugin marketplace add jjanczur/tyran',
    note: 'Registers this repository as a plugin marketplace inside Claude Code.',
  },
  {
    cmd: '/plugin install tyran@tyran',
    note: 'Installs the plugin: the conductor, the four agents, and the hooks.',
  },
  {
    cmd: '/tyran:setup',
    note:
      'Scans the repo, writes .tyran/config.yaml annotating every value with the fact that ' +
      'produced it, and asks you only about what it could not establish.',
  },
  {
    cmd: '/tyran',
    note: 'Then just describe what you want done. Also: /tyran:status, /tyran:doctor, /tyran:retro.',
  },
];

const BRAKE = 'echo "wrong branch - hold everything" > .tyran/STOP';

/**
 * The same install, handed to Claude instead of typed.
 *
 * `/plugin` is a slash command, which only a human can enter — so a prompt
 * saying "install yourself" would be an instruction the assistant cannot
 * carry out, and this page would open with a promise that fails on contact.
 * The `claude plugin ...` CLI is the same operation through a shell, which
 * Claude Code CAN run, and that is what the prompt asks for.
 *
 * It also asks for the restart and for a review of what setup inferred,
 * because both are real steps and a prompt that skips them leaves the reader
 * with hooks that are installed and not loaded.
 */
const PROMPT = [
  'Install the Tyran plugin in this repository and set it up for me.',
  '',
  '1. Run: claude plugin marketplace add jjanczur/tyran',
  '2. Run: claude plugin install tyran@tyran',
  '3. Tell me to restart Claude Code, so the hooks and agents load.',
  '4. After the restart, run /tyran:setup. It scans this repo and writes',
  '   .tyran/config.yaml. Walk me through what it inferred - especially the',
  '   validation commands and the deployment autonomy class - before we commit it.',
  '',
  'Docs: https://jjanczur.github.io/tyran/getting-started/',
].join('\n');
---

<section class="l-section" id="install">
  <div class="l-wrap">
    <div class="compound__head reveal">
      {/* The obelisk: a stone that is raised. This is the section where the
          thing goes up. */}
      <span class="l-sectmark"><Icon name="obelisk" size={30} /></span>
      <p class="l-eyebrow">Install</p>
      <h2>Two commands to install it, two more to be running</h2>
      <p class="l-lede">
        Requires Claude Code. Zero runtime dependencies, Apache-2.0, and it never writes into your{' '}
        <code>~/.claude</code>.
      </p>
    </div>

    <div class="install__grid">
      <ol class="steps reveal">
        {
          STEPS.map((step) => (
            <li>
              <button class="copy" type="button" data-copy={step.cmd}>
                <code>{step.cmd}</code>
                <span class="copy__hint" data-copy-hint>
                  copy
                </span>
              </button>
              <p>{step.note}</p>
            </li>
          ))
        }
      </ol>

      <aside class="install__aside reveal" style="--l-delay: 120ms">
        <h3><Icon name="lash" size={18} />The brake</h3>
        <p>
          Stop a run from anywhere, at any time, without killing the session. The conductor and every
          agent check for this file.
        </p>
        <button class="copy" type="button" data-copy={BRAKE}>
          <code>{BRAKE}</code>
          <span class="copy__hint" data-copy-hint>copy</span>
        </button>

        <h3 style="margin-top: 1.5rem"><Icon name="scroll" size={18} />Where to go next</h3>
        <ul class="linklist">
          <li><a href={DOCS.gettingStarted}>Getting started</a></li>
          <li><a href={DOCS.configuration}>Configuration and cost profiles</a></li>
          <li><a href={DOCS.faq}>FAQ &mdash; trust, models, updates, the name</a></li>
          <li><a href={REPO} rel="noopener">Source on GitHub</a></li>
          <li><a href={RELEASE} rel="noopener">Latest release</a></li>
        </ul>
      </aside>

      <div class="prompt reveal" style="--l-delay: 60ms">
        <div class="prompt__head">
          <h3><Icon name="cartouche" size={18} />Or do not type any of it</h3>
          <button class="copy copy--solo" type="button" data-copy={PROMPT}>
            <span class="copy__hint" data-copy-hint>copy prompt</span>
          </button>
        </div>
        <p>
          Paste this into Claude Code and let it do the install, the restart prompt and the first
          setup pass with you.
        </p>
        <pre>{PROMPT}</pre>
      </div>
    </div>
  </div>
</section>
