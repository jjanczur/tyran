---
/**
 * The landing's own top bar.
 *
 * Deliberately NOT Starlight's header: this page renders outside Starlight's
 * chrome, and reusing an internal component of the theme would couple the
 * landing to a package path that is not in Starlight's `exports` map.
 *
 * There is no theme control here any more. The site is dark everywhere by
 * decision, so the toggle is deleted rather than left offering a choice that
 * no longer exists — and with it goes the second copy of the `starlight-theme`
 * localStorage contract that used to live in this file's sibling script.
 *
 * The mark is `Logo.astro`, the same silhouette as `public/favicon.svg`. It
 * inherits `currentColor`, so the brand link colours the jackal and the
 * wordmark with one declaration and they can never drift apart.
 */
import Logo from './Logo.astro';
import { DOCS, REPO } from './urls';
---

<header class="l-nav">
  <div class="l-wrap l-nav__inner">
    <a class="l-brand" href="#top">
      <Logo size={26} class="l-brand__mark" />
      Tyran
    </a>

    <nav class="l-nav__links" aria-label="Primary">
      <a href="#compounding" data-optional>How it compounds</a>
      <a href="#gates" data-optional>The gates</a>
      <a href={DOCS.gettingStarted}>Docs</a>
      <a href={REPO} rel="noopener">GitHub</a>
    </nav>
  </div>
</header>
