---
/**
 * The footer, and the only place on the page that says who built it.
 *
 * Deliberately the LAST thing rather than a byline near the headline: a
 * project whose whole pitch is "mechanisms, not claims" should not open by
 * introducing its authors. Placed here it reads as a signature on finished
 * work, which is what it is.
 *
 * The release link is labelled `Latest release` rather than `Release v0.1.0`.
 * `RELEASE` already resolves to `releases/latest` and a test pins that, but
 * the guard inspects the URL and a hand-written version in the LABEL slips
 * past it — the link would keep working and keep naming the wrong version.
 */
import { DOCS, REPO, RELEASE, AUTHOR } from './urls';
import Icon from './Icon.astro';
---

<footer class="l-footer">
  <div class="l-wrap l-footer__inner">
    <p>
      Tyran &mdash; a task conductor for Claude Code. Apache-2.0. Built epic by epic, in public.
    </p>
    <nav aria-label="Footer">
      <a href={DOCS.gettingStarted}>Docs</a>
      <a href={DOCS.evidenceGate}>Evidence gate</a>
      <a href={DOCS.selfImprovement}>Self-improvement</a>
      <a href={REPO} rel="noopener">GitHub</a>
      <a href={RELEASE} rel="noopener">Latest release</a>
      <a href={`${REPO}/blob/main/LICENSE`} rel="noopener">License</a>
      <a href={`${REPO}/blob/main/CONTRIBUTING.md`} rel="noopener">Contributing</a>
    </nav>

    {/*
      The profile link is icon-only and sits next to the name it belongs to.
      `Icon` renders `aria-hidden` unconditionally — correct everywhere else on
      this page, where every glyph sits beside the text it illustrates — so
      here the link itself has to carry the accessible name, or a screen reader
      announces an empty link. It is also the one FILLED mark in the set; see
      the comment on `linkedin` in `Icon.astro`.
    */}
    <p class="l-footer__made">
      From Berlin with <span class="l-footer__heart" role="img" aria-label="love">&hearts;</span> by
      two buddies &mdash; <a href={AUTHOR.site} rel="noopener">Jacek</a><a
        class="l-footer__li"
        href={AUTHOR.linkedin}
        rel="noopener"
        aria-label="Jacek on LinkedIn"><Icon name="linkedin" size={14} /></a> and Piotr.
    </p>
  </div>
</footer>
