---
/**
 * A full-width illustration band between sections.
 *
 * These carry MOOD, not information. Everything a reader has to be able to act
 * on — the routing table, the refusal text, the event flow — is text or a
 * rendered diagram, because an image of a fact goes stale silently and cannot
 * be diffed. An illustration that tried to be a diagram would be the same
 * defect this project keeps removing, drawn instead of written.
 *
 * So each one is a single legible idea in the banner's own visual language,
 * `loading="lazy"` because none of them is above the fold, and the alt text
 * describes the picture rather than restating the section next to it — a
 * screen-reader user gets the argument from the prose either way, and hearing
 * it twice is worse than not hearing the artwork described at all.
 */
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="l-wrap scene reveal">
  <Picture
    src={src}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[320, 480, 640]}
    sizes="(min-width: 48rem) 19rem, 60vw"
    loading="lazy"
    decoding="async"
    alt={alt}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* An aside, not a band.
   *
   * These shipped full-width inside the 68rem wrap, which at 1440x900 made
   * each one taller than the viewport: three separate full-screen images
   * between four sections of text, on a page whose job is to explain a
   * developer tool. Art at that scale stops supporting the argument and
   * starts interrupting it, and the reader who came to find out what this
   * does has to scroll past a painting to keep reading.
   *
   * Now: a 19rem plate with the caption beside it, the pair centred and no
   * wider than 46rem. It reads as a margin illustration — noticed, enjoyed,
   * stepped over in about a second, which is the correct weight for something
   * that carries mood rather than information. */
  .scene {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 var(--l-gutter, 1.25rem);
  }

  /* The flex item is the `<picture>`, NOT the `<img>`.
   *
   * `<Picture>` emits `<picture><source ...><img></picture>`, so sizing the
   * img alone leaves the real flex child free to shrink. Measured: the plate
   * rendered 165px against the 304px it was told to be, because `<picture>`
   * had collapsed around a shrunken img and the img's own width resolved
   * against that. `flex: none` on the wrapper is what actually holds the
   * width; without it the three plates come out three different sizes,
   * each one fitted to its caption's longest word. */
  .scene :global(picture) {
    display: block;
    flex: none;
    width: 19rem;
    max-width: 55%;
  }

  .scene :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    /* The art is near-black at the edges; a hairline keeps it from bleeding
       into a dark page background and looking like a rendering failure. The
       frame is gold at low strength rather than white — a neutral hairline was
       the one edge left on the page that did not belong to the palette. */
    border: 1px solid color-mix(in srgb, var(--l-gold, #d4a017) 26%, transparent);
  }

  .scene figcaption {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    font-style: italic;
    color: var(--l-muted, rgb(255 255 255 / 0.6));
  }

  /* Under 34rem the pair stops working side by side: a 55% plate leaves the
     caption a column four words wide. Stack, and keep the plate small — the
     failure to avoid on a phone is an illustration that fills the screen. */
  @media (max-width: 34rem) {
    .scene {
      flex-direction: column;
      gap: 0.85rem;
      text-align: center;
    }

    .scene :global(picture) {
      width: min(16rem, 70vw);
      max-width: none;
    }
  }
</style>
